# Copy to prod.auto.tfvars (git-ignored) or pass with -var. Defaults live in variables.tf.

# IAM principals (besides the ECS task role) allowed to call the OpenSearch domain directly,
# for example the operator who runs backend/scripts/create_index.py.
# admin_principal_arns = ["arn:aws:iam::<ACCOUNT_ID>:user/<you>"]

# Only for a from-scratch rebuild before the nameserver cutover (default is true).
# dns_delegated = false

# Roll afefehub.com + www back to the old Lovable landing page (default is the CloudFront site).
# site_dns_target = "lovable"

# Scale the backend (0 while ECR is empty).
# desired_count = 1

# Pin a specific image instead of :latest.
# backend_image = "748201447723.dkr.ecr.us-east-1.amazonaws.com/afefehub-backend:v1"
