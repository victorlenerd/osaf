# Meta Model API (https://dev.meta.ai) — one key for Muse Spark, Muse Voice Transcribe, SAM 3.1
MODEL_API_KEY=
META_API_BASE=https://api.meta.ai/v1

# Google Places API (New)
GOOGLE_PLACES_API_KEY=

# WhatsApp Cloud API (Meta app with the WhatsApp product)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change-me
META_APP_SECRET=

# Optional: base64 of a Netscape cookies.txt for yt-dlp if Instagram rate-limits anonymous downloads
IG_COOKIES_B64=

# AWS (profile is only used locally; on ECS the task role is used)
AWS_PROFILE=prod
AWS_REGION=us-east-1
DYNAMO_TABLE=afefehub
MEDIA_BUCKET=afefehub-media-prod
OPENSEARCH_ENDPOINT=
PUBLIC_SITE_URL=https://afefehub.com
# Absolute base of this API; used for the audio URLs handed to the site (voice-note reviews)
PUBLIC_API_URL=http://localhost:8000
ENV=dev
