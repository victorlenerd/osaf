# Base URL of the Afefehub API (no trailing slash)
NEXT_PUBLIC_API_BASE=http://localhost:8000
# WhatsApp number reviewers send reel links to, shown on the home page. Leave empty to use the default (+1 (555) 137-0042) from lib/constants.ts
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Optional: link to the public source repository, shown on /about and in the footer
NEXT_PUBLIC_REPO_URL=https://github.com/victorlenerd/osaf
